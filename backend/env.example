# =============================================================================
# RENDER (Backend / API) — Environment Variables
# Service URL / custom domain: https://api.adcommedia.in
# =============================================================================

# MongoDB (Render Mongo or Atlas)
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER/DB
DB_NAME=adcom

# Google OAuth (from Google Cloud Console → Web client)
GOOGLE_CLIENT_ID=PASTE_REAL_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PASTE_REAL_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.adcommedia.in/api/auth/google/callback

# Frontend (Vercel custom domain)
PUBLIC_SITE_URL=https://adcommedia.in
FRONTEND_URL=https://adcommedia.in

# CORS — must list Vercel origins (no wildcards when using cookies)
CORS_ORIGINS=https://adcommedia.in,https://www.adcommedia.in

# Admin
ADMIN_ALLOWLIST=hello.adcommedia@gmail.com
ADMIN_EMAIL=hello.adcommedia@gmail.com
ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Optional
LEADS_INBOX=hello.adcommedia@gmail.com
